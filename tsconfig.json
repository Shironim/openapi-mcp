{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "types": ["bun", "node"]
  },
  "include": ["src/**/*", "scripts/compile.ts", "tests/**/*"],
  "exclude": ["node_modules", "dist"]
}
